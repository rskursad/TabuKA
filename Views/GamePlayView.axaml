<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabuKA.ViewModels"
             xmlns:controls="using:TabuKA.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="TabuKA.Views.GamePlayView"
             x:DataType="vm:GamePlayViewModel">

    <Design.DataContext>
        <vm:GamePlayViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.GameAction">
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style Selector="Button.GameAction:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="Button.Correct">
            <Setter Property="Background" Value="{StaticResource BrandCorrectGradient}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Correct:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#059669" />
        </Style>

        <Style Selector="Button.Taboo">
            <Setter Property="Background" Value="{StaticResource BrandTabooGradient}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Taboo:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <Style Selector="Button.Pass">
            <Setter Property="Background" Value="{StaticResource BrandPassGradient}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.Pass:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D97706" />
        </Style>
        <Style Selector="Button.Pass:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Button.HudButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.ForbiddenItem">
            <Setter Property="Background" Value="{DynamicResource AppForbiddenItemBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppForbiddenItemBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,2.5" />
        </Style>

        <Style Selector="Border.ForbiddenItem TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppForbiddenItemTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ================= RESPONSIVE OVERRIDES ================= -->

        <!-- Dar ekranda HUD butonları ikon + etiket olarak dikey yığılır,
             dokunma hedefleri büyütülür. -->
        <Style Selector="Button.GameAction">
            <Setter Property="Height" Value="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='66|60|60'}" />
        </Style>

        <Style Selector="Button.HudButton">
            <Setter Property="Padding" Value="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='10,8|14,8|14,8'}" />
            <Setter Property="FontSize" Value="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='12.5|13|13'}" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <!-- Root Dock Layout -->
        <DockPanel LastChildFill="True">

            <!-- Top HUD Bar -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource AppTopBarBgBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource AppTopBarBorderBrush}"
                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='10,8|16,10|16,10'}">
                <Grid>
                <!-- WIDE / TABLET: tek satırda duraklat · süre · skor · bitir -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}">
                    <Button Grid.Column="0"
                            Content="⏸ Duraklat"
                            Command="{Binding PauseGameCommand}"
                            Classes="HudButton"
                            IsEnabled="{Binding IsRoundActive}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding GameStatusText}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <controls:RoundTimerBadge />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="★ Skor Tablosu"
                                Command="{Binding ToggleScoreboardCommand}"
                                Background="{DynamicResource AppHeroBadgeBgBrush}"
                                Foreground="{DynamicResource AppHeroBadgeTextBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource AppHeroBadgeBorderBrush}"
                                Padding="14,8" FontSize="12.5" FontWeight="Bold" CornerRadius="10"
                                Cursor="Hand" MinHeight="44" />
                        <Button Content="Bitir"
                                Command="{Binding EndGameCommand}"
                                Background="#26DC2626" Foreground="#FF6B6B"
                                BorderThickness="1" BorderBrush="#55DC2626"
                                Padding="14,8" FontSize="12.5" FontWeight="Bold" CornerRadius="10"
                                Cursor="Hand" MinHeight="44" />
                    </StackPanel>
                </Grid>

                <!-- COMPACT: süre üstte, aksiyon butonları tam genişlikte altta -->
                <StackPanel IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}"
                            Spacing="8">
                    <controls:RoundTimerBadge HorizontalAlignment="Center" />

                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Classes="HudButton"
                                Command="{Binding PauseGameCommand}"
                                IsEnabled="{Binding IsRoundActive}"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="⏸" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Duraklat" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Classes="HudButton"
                                Command="{Binding ToggleScoreboardCommand}"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch" Margin="4,0">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="★" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Skor" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Classes="HudButton"
                                Command="{Binding EndGameCommand}"
                                HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                HorizontalContentAlignment="Center"
                                Background="#26DC2626" Foreground="#FF6B6B"
                                BorderBrush="#55DC2626">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="■" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Bitir" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Gaming Status Strip -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource AppTopBarBgBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource AppTopBarBorderBrush}"
                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='10,8|16,8|16,8'}">
                <Grid>
                <!-- COMPACT: sadece pas durumu + ses algılama -->
                <Grid ColumnDefinitions="*,*"
                      IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}">
                    <Border Grid.Column="0" Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                            CornerRadius="8" Padding="10,5" Margin="0,0,4,0"
                            BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}"
                            HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding PassStatusText}"
                                   FontWeight="Bold" FontSize="12"
                                   Foreground="#F59E0B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}"
                            Padding="10,5" Margin="4,0,0,0" CornerRadius="8"
                            ToolTip.Tip="Mikrofon durumu oyun boyunca kilitlidir">
                        <TextBlock Text="{Binding IsAutoTabooEnabled, Converter={StaticResource BoolToStatusTextConverter}}"
                                   FontSize="11.5" FontWeight="Bold"
                                   Foreground="{Binding IsAutoTabooEnabled, Converter={StaticResource BoolToStatusColorConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>

                <!-- WIDE / TABLET: tam durum şeridi -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                CornerRadius="8" Padding="12,5"
                                BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}">
                            <TextBlock Text="{Binding PassStatusText}"
                                       FontWeight="Bold" FontSize="12"
                                       Foreground="#F59E0B"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding CurrentGame.GameSettings.RoundTimeSeconds, StringFormat='• Toplam {0} sn'}"
                                   FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}"
                            Padding="12,5" CornerRadius="8"
                            ToolTip.Tip="Mikrofon durumu oyun boyunca kilitlidir"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Ses Algılama:"
                                       FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IsAutoTabooEnabled, Converter={StaticResource BoolToStatusTextConverter}}"
                                       FontSize="11.5" FontWeight="Bold"
                                       Foreground="{Binding IsAutoTabooEnabled, Converter={StaticResource BoolToStatusColorConverter}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="TabuKA"
                               FontWeight="Bold"
                               FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>
                </Grid>
            </Border>

            <!-- Main Interactive Play Area -->
            <Grid>
                <!-- Playing Area: kart kaydırılır, aksiyon butonları her zaman ekranda kalır -->
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              MaxWidth="520"
                              Margin="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='12,8|16,8|16,8'}">

                            <!-- Live Mini Score Bar -->
                            <Border Grid.Row="0" Background="{DynamicResource AppCardBackgroundBrush}"
                                    CornerRadius="12" Padding="14,6" Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    IsVisible="{Binding TeamScoreSummaryText, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="★" FontSize="15" Foreground="#F59E0B"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding TeamScoreSummaryText}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Detay"
                                            Command="{Binding ToggleScoreboardCommand}"
                                            Background="Transparent" Foreground="{DynamicResource AppHeroBadgeBorderBrush}"
                                            Padding="8,3" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                </Grid>
                            </Border>

                            <!-- Taboo Card Container -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource AppWordCardBackgroundBrush}"
                                    CornerRadius="18"
                                    BorderThickness="1.5"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='14,10|18,12|18,12'}"
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Stretch"
                                    BoxShadow="0 12 32 0 #35000000">
                                <StackPanel Spacing="10">
                                    <!-- Card Header: Category & Difficulty Badges -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource AppHeroBadgeBgBrush}"
                                                BorderThickness="1" BorderBrush="{DynamicResource AppHeroBadgeBorderBrush}"
                                                CornerRadius="9" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CurrentWord.Category.Name, FallbackValue='Genel'}"
                                                       FontSize="12" FontWeight="Black"
                                                       Foreground="{DynamicResource AppHeroBadgeTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                                BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}"
                                                CornerRadius="9" Padding="10,4">
                                            <TextBlock Text="{Binding CurrentWord.Difficulty, StringFormat='⭐ Zorluk: {0}/3'}"
                                                       FontSize="11.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Main Word (Hero Banner) -->
                                    <Border Margin="0,2"
                                            Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='12,8|16,10|16,10'}"
                                            Background="{DynamicResource AppMainWordBackgroundBrush}"
                                            CornerRadius="12"
                                            BorderThickness="1.5"
                                            BorderBrush="{DynamicResource AppHeroBadgeBorderBrush}">
                                        <TextBlock Text="{Binding CurrentWord.MainWord, FallbackValue='KART BEKLENİYOR'}"
                                                   FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='24|28|28'}"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource AppMainWordTextBrush}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   LetterSpacing="1.2"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Forbidden Words Header Divider -->
                                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,4">
                                        <Rectangle Grid.Column="0" Height="1.5" Fill="{DynamicResource AppCardBorderBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource AppForbiddenItemBgBrush}"
                                                BorderBrush="{DynamicResource AppForbiddenItemBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,3" Margin="8,0">
                                            <TextBlock Text="🚫 YASAKLI KELİMELER"
                                                       FontSize="11" FontWeight="Black" LetterSpacing="1"
                                                       Foreground="#FF2A55" />
                                        </Border>
                                        <Rectangle Grid.Column="2" Height="1.5" Fill="{DynamicResource AppCardBorderBrush}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Forbidden Words List -->
                                    <ItemsControl ItemsSource="{Binding CurrentWord.ForbiddenWords}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="ForbiddenItem">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="{Binding $parent[UserControl].((vm:GamePlayViewModel)DataContext).Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='15|17|17'}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Live Speech Feedback Banner -->
                            <Border Grid.Row="2"
                                    IsVisible="{Binding IsAutoTabooEnabled}"
                                    Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                    BorderBrush="#3B82F6" BorderThickness="1.5"
                                    CornerRadius="10" Padding="14,9" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="🎤" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SpeechDisplayStatus}"
                                               FontSize="12.5" FontWeight="Bold"
                                               Foreground="#38BDF8"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Pinned Action Bar (mobile'da kaydırmadan da erişilebilir) -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource AppTopBarBgBrush}"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource AppTopBarBorderBrush}"
                            Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='10,8|16,8|16,8'}">
                        <Grid ColumnDefinitions="*,*,*"
                              MaxWidth="520" HorizontalAlignment="Center"
                              IsEnabled="{Binding IsRoundActive}">
                            <!-- Correct Button -->
                            <Button Grid.Column="0" Classes="GameAction Correct"
                                    Command="{Binding SubmitCorrectCommand}"
                                    Margin="0,0,4,0">
                                <StackPanel Orientation="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='Vertical|Horizontal|Horizontal'}"
                                            Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock Text="DOĞRU" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock Text="+1" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                                               IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}" />
                                </StackPanel>
                            </Button>

                            <!-- Taboo Button -->
                            <Button Grid.Column="1" Classes="GameAction Taboo"
                                    Command="{Binding SubmitTabooCommand}"
                                    Margin="4,0">
                                <StackPanel Orientation="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='Vertical|Horizontal|Horizontal'}"
                                            Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="✕" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock Text="TABU" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock Text="-1" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                                               IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}" />
                                </StackPanel>
                            </Button>

                            <!-- Pass Button -->
                            <Button Grid.Column="2" Classes="GameAction Pass"
                                    Command="{Binding SubmitPassCommand}"
                                    IsEnabled="{Binding CanPass}"
                                    Margin="4,0,0,0">
                                <StackPanel Orientation="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='Vertical|Horizontal|Horizontal'}"
                                            Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="↷" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock Text="PAS" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock Text="GEÇ" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                                               IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Scoreboard Drawer -->
                <Border IsVisible="{Binding IsScoreboardOpen}"
                        Background="{DynamicResource AppModalOverlayBrush}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderThickness="0,0,1,0"
                            BorderBrush="{DynamicResource AppCardBorderBrush}"
                            Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='14|20|20'}"
                            Width="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='300|340|380'}"
                            MaxWidth="420"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Drawer Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                <TextBlock Grid.Column="0" Text="Skor Tablosu"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="✕ Kapat"
                                        Command="{Binding ToggleScoreboardCommand}"
                                        Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}"
                                        Padding="10,4" FontSize="12" CornerRadius="6" Cursor="Hand" MinHeight="40" />
                            </Grid>

                            <!-- Scoreboard & History Items -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="14">
                                    <ItemsControl ItemsSource="{Binding TeamScoreList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                                        CornerRadius="10" Padding="14,10" Margin="0,3"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource AppCardBorderBrush}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding TeamName}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Score, StringFormat='{} {0} Puan'}"
                                                                   FontSize="15" FontWeight="Bold"
                                                                   Foreground="#10B981"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,6" Background="{DynamicResource AppCardBorderBrush}" />

                                    <TextBlock Text="Son Oynanan Kartlar"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />

                                    <ItemsControl ItemsSource="{Binding RecentRounds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,6" Margin="0,2" CornerRadius="8"
                                                        Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                                        BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Word}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ResultText}"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="{Binding ResultColor}"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ================= MODALS & OVERLAYS ================= -->

        <!-- 1. Intermission / Ready Screen -->
        <Border IsVisible="{Binding IsReadyIntermission}"
                Background="{DynamicResource AppModalOverlayBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource AppCardBackgroundBrush}"
                    CornerRadius="16"
                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='18,16|24,20|28,24'}"
                    MaxWidth="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='340|400|440'}"
                    Margin="14"
                    BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 16 36 0 #30000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource AppHeroBadgeBgBrush}" CornerRadius="12"
                            Width="54" Height="54" HorizontalAlignment="Center">
                        <TextBlock Text="★" FontSize="26" Foreground="{DynamicResource AppHeroBadgeTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Sıradaki Takım"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentTeam.Name}"
                                   FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='22|26|26'}"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding CurrentGame.CurrentRound, StringFormat='Tur {0}'}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#6366F1" HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Yasaklı kelimeleri kullanmadan en çok kelimeyi takımına anlat. Hazır olduğunuzda başlatın."
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4" />

                    <Button Content="🚀 Turu Başlat"
                            Command="{Binding StartTurnCommand}"
                            Classes="GameAction"
                            Background="{StaticResource BrandHeroGradient}"
                            Foreground="White"
                            MaxWidth="340" Height="52"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 2. Turn Summary Screen -->
        <Border IsVisible="{Binding IsTurnSummary}"
                Background="{DynamicResource AppModalOverlayBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource AppCardBackgroundBrush}"
                    CornerRadius="20"
                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='18,16|24,20|28,24'}"
                    MaxWidth="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='340|400|440'}"
                    Margin="14"
                    BorderThickness="1.5" BorderBrush="{DynamicResource AppCardBorderBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 18 40 0 #40000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="⏱ Süre Doldu!"
                               FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='22|26|26'}"
                               FontWeight="Black"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding CurrentTeam.Name, StringFormat='{}{0} • Tur Özeti'}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />

                    <!-- Stats Grid -->
                    <Border Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                            CornerRadius="14" Padding="18,14" Margin="0,6"
                            BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}">
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="DOĞRU" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding TurnCorrectCount}" FontSize="26" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center" />

                            <TextBlock Grid.Column="1" Grid.Row="0" Text="TABU" FontSize="11" FontWeight="Bold" Foreground="#FF2A55" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding TurnTabooCount}" FontSize="26" FontWeight="Black" Foreground="#FF2A55" HorizontalAlignment="Center" />

                            <TextBlock Grid.Column="2" Grid.Row="0" Text="PAS" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding TurnPassCount}" FontSize="26" FontWeight="Black" Foreground="#F59E0B" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource AppHeroBadgeBgBrush}"
                            BorderBrush="{DynamicResource AppHeroBadgeBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,6">
                        <TextBlock Text="{Binding TurnScoreDelta, StringFormat='Kazanılan Puan: {0}'}"
                                   FontSize="15" FontWeight="Black"
                                   Foreground="{DynamicResource AppHeroBadgeTextBrush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>

                    <Button Content="Sıradaki Takıma Geç ›"
                            Command="{Binding ProceedToNextTurnCommand}"
                            Classes="GameAction"
                            Background="{StaticResource BrandHeroGradient}"
                            Foreground="White"
                            MaxWidth="340" Height="52"
                            HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 3. Pause Overlay -->
        <Border IsVisible="{Binding IsPaused}"
                Background="{DynamicResource AppModalOverlayBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource AppCardBackgroundBrush}"
                    CornerRadius="20"
                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='18,16|24,20|28,24'}"
                    MaxWidth="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='320|360|380'}"
                    Margin="14"
                    BorderThickness="1.5" BorderBrush="{DynamicResource AppCardBorderBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 18 40 0 #40000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="⏸ Oyun Duraklatıldı"
                               FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='19|22|22'}"
                               FontWeight="Black"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="Mola bittiğinde devam edebilirsiniz." FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />

                    <Button Content="Oyuna Devam Et"
                            Command="{Binding ResumeGameCommand}"
                            Classes="GameAction Correct"
                            MaxWidth="280" Height="50"
                            HorizontalAlignment="Stretch" />

                    <Button Content="Oyunu Bitir"
                            Command="{Binding EndGameCommand}"
                            Classes="GameAction Taboo"
                            MaxWidth="280" Height="46"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 4. Victory Royale / Game Over Screen -->
        <Border IsVisible="{Binding IsGameFinished}"
                Background="{DynamicResource AppModalOverlayBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource AppCardBackgroundBrush}"
                    CornerRadius="20"
                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='20,18|26,24|32,28'}"
                    MaxWidth="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='340|420|460'}"
                    Margin="14"
                    BorderThickness="2" BorderBrush="{DynamicResource AppHeroBadgeBorderBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 20 48 0 #50000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource AppMenuIconStatsBgBrush}"
                            BorderBrush="{DynamicResource AppMenuIconStatsBorderBrush}" BorderThickness="1.5"
                            CornerRadius="20" Width="72" Height="72" HorizontalAlignment="Center">
                        <TextBlock Text="🏆" FontSize="38"
                                   Foreground="{DynamicResource AppMenuIconStatsFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="OYUN TAMAMLANDI!"
                               FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='19|22|22'}"
                               FontWeight="Black"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding WinnerText}"
                               FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='22|26|26'}"
                               FontWeight="Black"
                               Foreground="#10B981" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding WinnerDetailsText}"
                               FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" />

                    <Separator Margin="0,8" Background="{DynamicResource AppCardBorderBrush}" />

                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="Tekrar Oyna"
                                Command="{Binding PlayAgainCommand}"
                                Classes="GameAction"
                                Background="{StaticResource BrandHeroGradient}"
                                Foreground="White"
                                Height="50" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="Ana Menü"
                                Command="{Binding GoBackCommand}"
                                Classes="GameAction Pass"
                                Height="50" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 5. Instant Taboo Flash Banner -->
        <Border IsVisible="{Binding TabooDetected}"
                Background="#E6F43F5E"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        Margin="20">
                <TextBlock Text="TABU!"
                           FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='38|48|48'}"
                           FontWeight="Black" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center" LetterSpacing="2"
                           TextWrapping="Wrap" />
                <TextBlock Text="Yasaklı kelime kullanıldı (-1 Puan)"
                           FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='14|16|16'}"
                           Foreground="White"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
