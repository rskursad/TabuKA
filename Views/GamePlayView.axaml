<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabuKA.ViewModels"
             xmlns:converters="using:TabuKA.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="TabuKA.Views.GamePlayView"
             x:DataType="vm:GamePlayViewModel">

    <Design.DataContext>
        <vm:GamePlayViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.ArcadeAction">
            <Setter Property="Height" Value="58" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style Selector="Button.ArcadeAction:pointerover">
            <Setter Property="Opacity" Value="0.92" />
        </Style>

        <Style Selector="Button.ArcadeAction:pressed">
            <Setter Property="BorderThickness" Value="0,2,0,2" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style Selector="Button.Correct">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="BorderBrush" Value="#047857" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Taboo">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="BorderBrush" Value="#991B1B" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Pass">
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="BorderBrush" Value="#B45309" />
            <Setter Property="Foreground" Value="#1E1B4B" />
        </Style>

        <Style Selector="Button.Pass:disabled">
            <Setter Property="Background" Value="#4B5563" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="Foreground" Value="#9CA3AF" />
        </Style>

        <Style Selector="Border.ForbiddenItem">
            <Setter Property="Background" Value="#251215" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#0A0E17">
        <!-- Root Dock Layout -->
        <DockPanel LastChildFill="True">

            <!-- Top HUD Bar -->
            <Border DockPanel.Dock="Top"
                    Background="#111827"
                    BorderThickness="0,0,0,3"
                    BorderBrush="#374151"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Pause Button -->
                    <Button Grid.Column="0"
                            Content="⏸ MOLA"
                            Command="{Binding PauseGameCommand}"
                            FontFamily="{StaticResource PixelFont}"
                            Background="#374151" Foreground="#F3F4F6"
                            BorderThickness="0,0,0,3" BorderBrush="#1F2937"
                            Padding="10,6" FontSize="12" FontWeight="Bold" CornerRadius="8"
                            IsEnabled="{Binding IsRoundActive}" />

                    <!-- Center Turn & Timer Display -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                            <TextBlock Text="👑" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GameStatusText}"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#FBBF24"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Glowing Digital Timer -->
                        <Border Background="#030712"
                                CornerRadius="10" Padding="14,2" Margin="0,1,0,0"
                                BorderThickness="2"
                                BorderBrush="{Binding IsUrgentTime, Converter={StaticResource StatusToBorderConverter}}">
                            <TextBlock Text="{Binding TimeRemaining, StringFormat='⏱ {0} SN'}"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="24" FontWeight="Black"
                                       Foreground="{Binding IsUrgentTime, Converter={StaticResource BoolToStatusColorConverter}}"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Scoreboard Toggle & End Game Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="🏆 SKOR"
                                Command="{Binding ToggleScoreboardCommand}"
                                FontFamily="{StaticResource PixelFont}"
                                Background="#4338CA" Foreground="#E0E7FF"
                                BorderThickness="0,0,0,3" BorderBrush="#312E81"
                                Padding="10,6" FontSize="12" FontWeight="Bold" CornerRadius="8" />
                        <Button Content="⏹ BİTİR"
                                Command="{Binding EndGameCommand}"
                                FontFamily="{StaticResource PixelFont}"
                                Background="#DC2626" Foreground="White"
                                BorderThickness="0,0,0,3" BorderBrush="#991B1B"
                                Padding="10,6" FontSize="12" FontWeight="Bold" CornerRadius="8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Gaming Status Strip (Responsive Wrap) -->
            <Border DockPanel.Dock="Bottom"
                    Background="#111827"
                    BorderThickness="0,2,0,0"
                    BorderBrush="#374151"
                    Padding="12,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Border Background="#1F2937" CornerRadius="6" Padding="8,2" BorderThickness="1" BorderBrush="#4B5563">
                            <TextBlock Text="{Binding PassStatusText}"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontWeight="Bold" FontSize="11"
                                       Foreground="#F59E0B"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding CurrentGame.GameSettings.RoundTimeSeconds, StringFormat='• {0} SN'}"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="11" Foreground="#9CA3AF"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#1F2937" BorderThickness="1" BorderBrush="#374151"
                            Padding="8,3" CornerRadius="8"
                            ToolTip.Tip="Mikrofon durumu oyun boyunca kilitlidir"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🎤 SES:"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="11" Foreground="#9CA3AF"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IsAutoTabooEnabled, Converter={StaticResource BoolToStatusTextConverter}}"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding IsAutoTabooEnabled, Converter={StaticResource BoolToStatusColorConverter}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="👾 TabuKA"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="11" Foreground="#6B7280"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Main Interactive Play Area -->
            <Grid>
                <!-- Playing Area (Responsive Stretch & Centered) -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center"
                          MaxWidth="560" Margin="12,10">

                        <!-- Live Mini Score Bar -->
                        <Border Grid.Row="0" Background="#18181B" CornerRadius="8"
                                Padding="12,6" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch" BorderThickness="1" BorderBrush="#27272A"
                                IsVisible="{Binding TeamScoreSummaryText, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="🏆" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding TeamScoreSummaryText}"
                                           FontFamily="{StaticResource PixelFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#A5B4FC"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Detay ↗"
                                        Command="{Binding ToggleScoreboardCommand}"
                                        FontFamily="{StaticResource PixelFont}"
                                        Background="Transparent" Foreground="#FCD34D"
                                        Padding="4,2" FontSize="11" />
                            </Grid>
                        </Border>

                        <!-- Legendary Word Card -->
                        <Border Grid.Row="1"
                                Background="#18181B"
                                CornerRadius="18"
                                BorderThickness="3"
                                BorderBrush="#F59E0B"
                                Padding="20,16" Margin="0,0,0,14"
                                HorizontalAlignment="Stretch"
                                BoxShadow="0 10 30 0 #50000000">
                            <StackPanel Spacing="12">
                                <!-- Card Header: Category & Difficulty Badges -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Border Grid.Column="0"
                                            Background="#27272A"
                                            BorderThickness="2" BorderBrush="#52525B"
                                            CornerRadius="8" Padding="10,4" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="💎" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CurrentWord.Category.Name, FallbackValue='Genel'}"
                                                       FontFamily="{StaticResource PixelFont}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="#38BDF8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Background="#27272A"
                                            BorderThickness="2" BorderBrush="#52525B"
                                            CornerRadius="8" Padding="10,4">
                                        <TextBlock Text="{Binding CurrentWord.Difficulty, StringFormat='⭐ {0}/3'}"
                                                   FontFamily="{StaticResource PixelFont}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#FBBF24"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Main Word (Hero text) -->
                                <Border Margin="0,4" Padding="8,12"
                                        Background="#09090B" CornerRadius="10"
                                        BorderThickness="2" BorderBrush="#3F3F46">
                                    <TextBlock Text="{Binding CurrentWord.MainWord, FallbackValue='KART BEKLENİYOR'}"
                                               FontFamily="{StaticResource PixelFont}"
                                               FontSize="32" FontWeight="Black"
                                               Foreground="#FCD34D"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- Forbidden Words Title -->
                                <Border Background="#450A0A" CornerRadius="6" Padding="10,3" HorizontalAlignment="Center"
                                        BorderThickness="1" BorderBrush="#991B1B">
                                    <TextBlock Text="☠️ YASAKLI KELİMELER ☠️"
                                               FontFamily="{StaticResource PixelFont}"
                                               FontSize="11" FontWeight="Black"
                                               Foreground="#F87171"
                                               HorizontalAlignment="Center" />
                                </Border>

                                <!-- Forbidden Words List -->
                                <ItemsControl ItemsSource="{Binding CurrentWord.ForbiddenWords}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="ForbiddenItem">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="{StaticResource PixelFont}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="#FCA5A5"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Live Speech Feedback Banner -->
                        <Border Grid.Row="2"
                                IsVisible="{Binding IsAutoTabooEnabled}"
                                Background="#18181B" BorderBrush="#3B82F6" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="🎙️" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SpeechDisplayStatus}"
                                           FontFamily="{StaticResource PixelFont}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#60A5FA"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" Margin="0,0,0,8"
                              IsEnabled="{Binding IsRoundActive}">
                            <!-- Correct Button -->
                            <Button Grid.Column="0" Classes="ArcadeAction Correct"
                                    Command="{Binding SubmitCorrectCommand}"
                                    Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="✅" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="DOĞRU (+1)" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Taboo Button -->
                            <Button Grid.Column="1" Classes="ArcadeAction Taboo"
                                    Command="{Binding SubmitTabooCommand}"
                                    Margin="2,0,2,0">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="🚫" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="TABU (-1)" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Pass Button -->
                            <Button Grid.Column="2" Classes="ArcadeAction Pass"
                                    Command="{Binding SubmitPassCommand}"
                                    IsEnabled="{Binding CanPass}"
                                    Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="⏭️" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="PAS GEÇ" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- Slide-over / Modal Scoreboard Drawer -->
                <Border IsVisible="{Binding IsScoreboardOpen}"
                        Background="#B0000000"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border Background="#0F172A"
                            BorderThickness="0,0,3,0"
                            BorderBrush="#38BDF8"
                            Padding="16"
                            Width="340" MaxWidth="400" Margin="0,0,32,0"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Drawer Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🏆" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Text="SKOR TABLOSU"
                                               FontFamily="{StaticResource PixelFont}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#FCD34D"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕ KAPAT"
                                        Command="{Binding ToggleScoreboardCommand}"
                                        FontFamily="{StaticResource PixelFont}"
                                        Background="#374151" Foreground="#E5E7EB"
                                        Padding="8,4" FontSize="11" CornerRadius="6" />
                            </Grid>

                            <!-- Scoreboard & History Items -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="14">
                                    <ItemsControl ItemsSource="{Binding TeamScoreList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1B4B"
                                                        CornerRadius="10" Padding="12,8" Margin="0,3"
                                                        BorderThickness="2"
                                                        BorderBrush="#4338CA">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="🛡️" FontSize="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding TeamName}"
                                                                       FontFamily="{StaticResource PixelFont}"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       Foreground="#E0E7FF"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Score, StringFormat='{} {0} P'}"
                                                                   FontFamily="{StaticResource PixelFont}"
                                                                   FontSize="16" FontWeight="Black"
                                                                   Foreground="#34D399"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,4" Background="#334155" />

                                    <Border Background="#1E293B" CornerRadius="6" Padding="8,4" HorizontalAlignment="Stretch">
                                        <TextBlock Text="📜 SON KARTLAR"
                                                   FontFamily="{StaticResource PixelFont}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding RecentRounds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,5" Margin="0,2" CornerRadius="6"
                                                        Background="#1E293B" BorderThickness="1" BorderBrush="#334155">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding TeamName}"
                                                                   FontSize="10" Margin="0,0,6,0"
                                                                   Foreground="#94A3B8"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Word}"
                                                                   FontFamily="{StaticResource PixelFont}"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="#F8FAFC"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ResultText}"
                                                                   FontFamily="{StaticResource PixelFont}"
                                                                   FontSize="11" FontWeight="Black"
                                                                   Foreground="{Binding ResultColor}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ================= ARCADE MODALS & OVERLAYS ================= -->

        <!-- 1. Intermission / Ready Screen -->
        <Border IsVisible="{Binding IsReadyIntermission}"
                Background="#FA0A0E17"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#18181B"
                    CornerRadius="20" Padding="24,20" MaxWidth="480" Margin="16"
                    BorderThickness="4" BorderBrush="#10B981"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 36 0 #70000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="52" HorizontalAlignment="Center" />
                    <TextBlock Text="RAUNT BAŞLIYOR"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#A1A1AA" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentTeam.Name}"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="28" FontWeight="Black"
                               Foreground="#FCD34D" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding CurrentGame.CurrentRound, StringFormat='★ {0}. TUR ★'}"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#38BDF8" HorizontalAlignment="Center" />
                    <TextBlock Text="Yasaklı kelimeleri kullanmadan en çok kelimeyi takımına anlat! Süre boyunca aralıksız anlatım devam eder."
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="#D4D4D8" MaxWidth="380" Margin="0,4" />
                    <Button Content="🚀 TURU BAŞLAT! (SÜRE AKACAK)"
                            Command="{Binding StartTurnCommand}"
                            Classes="ArcadeAction Correct"
                            MaxWidth="380" Height="52"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 2. Turn Summary Screen -->
        <Border IsVisible="{Binding IsTurnSummary}"
                Background="#FA0A0E17"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#18181B"
                    CornerRadius="20" Padding="24,20" MaxWidth="480" Margin="16"
                    BorderThickness="4" BorderBrush="#F59E0B"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="⏱️" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="SÜRE DOLDU!"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="24" FontWeight="Black"
                               Foreground="#F87171" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentTeam.Name, StringFormat='{}{0} TUR ÖZETİ'}"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#FCD34D" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />

                    <!-- Stats Grid -->
                    <Border Background="#09090B" CornerRadius="12" Padding="16,12" Margin="0,6"
                            BorderThickness="2" BorderBrush="#27272A">
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="DOĞRU" FontFamily="{StaticResource PixelFont}" FontSize="11" Foreground="#34D399" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding TurnCorrectCount}" FontFamily="{StaticResource PixelFont}" FontSize="24" FontWeight="Black" Foreground="#34D399" HorizontalAlignment="Center" />

                            <TextBlock Grid.Column="1" Grid.Row="0" Text="TABU" FontFamily="{StaticResource PixelFont}" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding TurnTabooCount}" FontFamily="{StaticResource PixelFont}" FontSize="24" FontWeight="Black" Foreground="#F87171" HorizontalAlignment="Center" />

                            <TextBlock Grid.Column="2" Grid.Row="0" Text="PAS" FontFamily="{StaticResource PixelFont}" FontSize="11" Foreground="#FBBF24" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding TurnPassCount}" FontFamily="{StaticResource PixelFont}" FontSize="24" FontWeight="Black" Foreground="#FBBF24" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding TurnScoreDelta, StringFormat='NET PUAN: {0} XP'}"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="18" FontWeight="Black"
                               Foreground="#38BDF8" HorizontalAlignment="Center" />

                    <Button Content="➡️ SIRADAKİ TAKIMA GEÇ"
                            Command="{Binding ProceedToNextTurnCommand}"
                            Classes="ArcadeAction Correct"
                            MaxWidth="360" Height="50"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 3. Pause Overlay -->
        <Border IsVisible="{Binding IsPaused}"
                Background="#EE0A0E17"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#18181B"
                    CornerRadius="18" Padding="24,20" MaxWidth="400" Margin="16"
                    BorderThickness="3" BorderBrush="#6366F1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="⏸️" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="OYUN DURAKLATILDI"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="20" FontWeight="Black"
                               Foreground="#E0E7FF" HorizontalAlignment="Center" />
                    <TextBlock Text="Mola bittiğinde devam edin." FontSize="13"
                               Foreground="#A1A1AA" HorizontalAlignment="Center" />

                    <Button Content="▶️ DEVAM ET"
                            Command="{Binding ResumeGameCommand}"
                            Classes="ArcadeAction Correct"
                            MaxWidth="280" Height="48"
                            HorizontalAlignment="Stretch" />

                    <Button Content="⏹️ OYUNU BİTİR"
                            Command="{Binding EndGameCommand}"
                            Classes="ArcadeAction Taboo"
                            MaxWidth="280" Height="46"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 4. Victory Royale / Game Over Screen -->
        <Border IsVisible="{Binding IsGameFinished}"
                Background="#F50A0E17"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#18181B"
                    CornerRadius="22" Padding="24,20" MaxWidth="480" Margin="16"
                    BorderThickness="4" BorderBrush="#FBBF24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 14 40 0 #80000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="👑" FontSize="56" HorizontalAlignment="Center" />
                    <TextBlock Text="★ ZAFER ŞAMPİYONUN! ★"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="22" FontWeight="Black"
                               Foreground="#FCD34D" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding WinnerText}"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="24" FontWeight="Black"
                               Foreground="#34D399" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding WinnerDetailsText}"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#E0E7FF"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" />

                    <Separator Margin="0,6" Background="#334155" />

                    <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                        <Button Grid.Column="0" Content="🔄 TEKRAR"
                                Command="{Binding PlayAgainCommand}"
                                Classes="ArcadeAction Correct"
                                Height="48" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="🏠 MENÜ"
                                Command="{Binding GoBackCommand}"
                                Classes="ArcadeAction Pass"
                                Height="48" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 5. Instant Taboo Flash Banner -->
        <Border IsVisible="{Binding TabooDetected}"
                Background="#E6DC2626"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="☠️" FontSize="80" HorizontalAlignment="Center" />
                <TextBlock Text="TABU!"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="52" FontWeight="Black" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="YASAKLI KELİME KULLANILDI (-1 PUAN)"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="16" Foreground="White"
                           FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>