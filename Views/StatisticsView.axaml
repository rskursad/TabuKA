<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabuKA.ViewModels"
             xmlns:controls="using:TabuKA.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="TabuKA.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

    <Design.DataContext>
        <vm:StatisticsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.StatCard">
            <Setter Property="Padding" Value="{Binding $parent[UserControl].((vm:StatisticsViewModel)DataContext).Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='12|20|20'}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="140" />
        </Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="{Binding $parent[UserControl].((vm:StatisticsViewModel)DataContext).Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='16|19|20'}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='12,20|32,20|32,20'}"
                    HorizontalAlignment="Center" MaxWidth="1200">
                <StackPanel Spacing="18">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="← ANA MENÜ" Command="{Binding GoBackCommand}"
                                FontFamily="{StaticResource PixelFont}"
                                Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                Foreground="{DynamicResource AppTextPrimaryBrush}"
                                BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1"
                                Padding="14,8" FontSize="13" CornerRadius="10" MinHeight="44"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}" />
                        <Button Grid.Column="0" Content="←" Command="{Binding GoBackCommand}"
                                FontFamily="{StaticResource PixelFont}"
                                Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                Foreground="{DynamicResource AppTextPrimaryBrush}"
                                BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1"
                                Padding="14,8" FontSize="16" CornerRadius="10" MinHeight="44"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}" />

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2" Margin="8,0">
                            <TextBlock Text="🏆 SKOR TABLOLARI"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='19|26|26'}"
                                       FontWeight="Black" Foreground="#FCD34D"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="OYUN PERFORMANSI VE ŞAMPİYONLUK GEÇMİŞİ"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="🔄 YENİLE" Command="{Binding RefreshCommand}"
                                FontFamily="{StaticResource PixelFont}"
                                Background="#10B981" Foreground="White"
                                BorderThickness="1" BorderBrush="#0F9D76"
                                Padding="14,8" FontSize="13" CornerRadius="10" MinHeight="44"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}"
                                IsEnabled="{Binding !IsLoading}" />
                        <Button Grid.Column="2" Content="🔄" Command="{Binding RefreshCommand}"
                                FontFamily="{StaticResource PixelFont}"
                                Background="#10B981" Foreground="White"
                                BorderThickness="1" BorderBrush="#0F9D76"
                                Padding="14,8" FontSize="14" CornerRadius="10" MinHeight="44"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}"
                                IsEnabled="{Binding !IsLoading}" />
                    </Grid>

                    <!-- Loading Indicator -->
                    <Border IsVisible="{Binding IsLoading}"
                            Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                            BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="24" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="24" Height="24" />
                            <TextBlock Text="Yükleniyor..." VerticalAlignment="Center" FontSize="15"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Summary Cards: dar ekranda 2 sütuna sarılır -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="StatCard">
                        <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='2|3|5'}"
                                               ColumnSpacing="8" RowSpacing="8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalGamesPlayed}"
                                           FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='22|32|32'}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Oynanan Oyun" FontSize="11.5"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalRoundsPlayed}"
                                           FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='22|32|32'}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Toplam Tur" FontSize="11.5"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalWordsGuessed}"
                                           FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='22|32|32'}"
                                           FontWeight="Bold" Foreground="#4CAF50"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Doğru Tahmin" FontSize="11.5"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalTabooViolations}"
                                           FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='22|32|32'}"
                                           FontWeight="Bold" Foreground="#F44336"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Tabu İhlali" FontSize="11.5"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AverageScorePerGame, StringFormat='{}{0:F1}'}"
                                           FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='22|32|32'}"
                                           FontWeight="Bold" Foreground="#FF9800"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Ort. Puan/Oyun" FontSize="11.5"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </controls:ReflowPanel>
                    </Border>

                    <!-- Team Statistics -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="StatCard">
                        <StackPanel Spacing="10">
                            <TextBlock Text="👥 Takım İstatistikleri" Classes="SectionTitle" />
                            <DataGrid ItemsSource="{Binding TeamStats}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      MaxHeight="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='260|300|300'}"
                                      Margin="0,4,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Takım" Binding="{Binding TeamName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Oyun" Binding="{Binding GamesPlayed}" Width="0.8*" />
                                    <DataGridTextColumn Header="Puan" Binding="{Binding TotalScore}" Width="0.9*" />
                                    <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectAnswers}" Width="0.8*" />
                                    <DataGridTextColumn Header="Tabu" Binding="{Binding TabooViolations}" Width="0.8*" />
                                    <DataGridTextColumn Header="Pas" Binding="{Binding PassesUsed}" Width="0.8*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Category Statistics -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="StatCard">
                        <StackPanel Spacing="10">
                            <TextBlock Text="📂 Kategori Bazında Performans" Classes="SectionTitle" />
                            <DataGrid ItemsSource="{Binding CategoryStats}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      MaxHeight="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='260|300|300'}"
                                      Margin="0,4,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="1.6*" />
                                    <DataGridTextColumn Header="Oynama" Binding="{Binding TimesPlayed}" Width="0.9*" />
                                    <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectGuesses}" Width="0.9*" />
                                    <DataGridTextColumn Header="Tabu" Binding="{Binding TabooCount}" Width="0.9*" />
                                    <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat='{}{0:F1}%'}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Game History -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="StatCard">
                        <StackPanel Spacing="10">
                            <TextBlock Text="🕐 Oyun Geçmişi (Son 20)" Classes="SectionTitle" />
                            <DataGrid ItemsSource="{Binding GameHistory}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      MaxHeight="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='260|300|300'}"
                                      Margin="0,4,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="1.4*" />
                                    <DataGridTextColumn Header="Kazanan" Binding="{Binding Winner}" Width="1.4*" />
                                    <DataGridTextColumn Header="Tur" Binding="{Binding TotalRounds}" Width="0.8*" />
                                    <DataGridTextColumn Header="Puan" Binding="{Binding TotalScore}" Width="0.9*" />
                                    <DataGridTextColumn Header="Süre" Binding="{Binding Duration}" Width="0.9*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
