<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabuKA.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="TabuKA.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.NavButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        
        <Style Selector="Button.DangerButton">
            <Setter Property="Background" Value="#F44336" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        
        <Style Selector="Button.DangerButton:pointerover">
            <Setter Property="Background" Value="#D32F2F" />
        </Style>
        
        <Style Selector="TextBlock.SettingLabel">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#0A0E17">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="32,20" HorizontalAlignment="Center" MaxWidth="820">
                <StackPanel Spacing="24">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="← ANA MENÜ" Command="{Binding GoBackCommand}" 
                                FontFamily="{StaticResource PixelFont}"
                                Background="#374151" Foreground="#F3F4F6"
                                Padding="14,8" FontSize="13" CornerRadius="8"
                                VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="⚙️ SİSTEM AYARLARI" 
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="26" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center" />
                            <TextBlock Text="GÖRÜNÜM, SES, MOTOR VE VERİ YÖNETİMİ" 
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="#9CA3AF" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                <!-- Loading Indicator -->
                <Border IsVisible="{Binding IsLoading}" 
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        CornerRadius="8" Padding="24" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="24" Height="24" />
                        <TextBlock Text="Yükleniyor..." VerticalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Border>

                <!-- Theme Settings -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Padding="24" CornerRadius="12"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🎨 Görünüm" FontSize="20" FontWeight="SemiBold" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="Tema:" Classes="SettingLabel" Width="120" />
                            <ComboBox ItemsSource="{Binding Themes}" 
                                      SelectedItem="{Binding SelectedTheme}"
                                      Width="200" Padding="12,8" FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sound Settings -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Padding="24" CornerRadius="12"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🔊 Ses ve Efekt Ayarları" FontSize="20" FontWeight="SemiBold" />
                        
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Genel Ses:" Classes="SettingLabel" Width="120" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume}" 
                                        Width="260" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0}%'}" 
                                           FontSize="14" FontWeight="Medium" Width="45" 
                                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="🔔 Sesi Test Et" Command="{Binding TestSoundCommand}"
                                        Padding="10,6" FontSize="13" CornerRadius="6" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Speech Recognition Engine Settings -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Padding="24" CornerRadius="12"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🎤 Konuşma Tanıma (Otomatik Tabu)" FontSize="20" FontWeight="SemiBold" />
                        
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Tanıma Motoru:" Classes="SettingLabel" Width="140" />
                                <ComboBox ItemsSource="{Binding SpeechEngines}" 
                                          SelectedItem="{Binding SelectedSpeechEngine}"
                                          Width="220" Padding="12,8" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="• Simulation: Test amaçlı simülasyon motoru&#x0a;• Vosk (Offline): Çevrimdışı Türkçe ses tanıma motoru"
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- General Settings -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Padding="24" CornerRadius="12"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="⚙️ Genel Ayarlar" FontSize="20" FontWeight="SemiBold" />
                        
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Otomatik Kaydet:" Classes="SettingLabel" Width="180" />
                                <ToggleSwitch IsChecked="{Binding AutoSave}" />
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Öğretici Göster:" Classes="SettingLabel" Width="180" />
                                <ToggleSwitch IsChecked="{Binding ShowTutorial}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Database Management -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Padding="24" CornerRadius="12"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🗄️ Veritabanı Yönetimi" FontSize="20" FontWeight="SemiBold" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="Kelime Sayısı:" Classes="SettingLabel" Width="140" />
                            <TextBlock Text="{Binding WordCount}" FontSize="16" FontWeight="Bold" 
                                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                            <TextBlock Text="Kategori Sayısı:" Classes="SettingLabel" Width="140" Margin="24,0,0,0" />
                            <TextBlock Text="{Binding CategoryCount}" FontSize="16" FontWeight="Bold" 
                                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Veritabanı:" Classes="SettingLabel" Width="100" />
                            <TextBlock Text="{Binding DatabasePath}" FontSize="14" 
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="NavButton" Command="{Binding ExportDatabaseCommand}"
                                    Content="📤 JSON Olarak Dışa Aktar" />
                            <Button Classes="NavButton" Command="{Binding BackupDatabaseCommand}"
                                    Content="💾 Veritabanı Yedeği Al" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="NavButton" Command="{Binding ImportDatabaseCommand}"
                                    Content="📥 JSON'dan İçe Aktar" />
                            <Button Classes="NavButton" Command="{Binding OpenWordManagementCommand}"
                                    Content="📝 Kelime Yönetimi" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="DangerButton" Command="{Binding ResetDatabaseCommand}"
                                    Content="🔄 Fabrika Ayarlarına Sıfırla" Width="400" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status Message -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Padding="16" CornerRadius="8"
                        Background="{Binding StatusMessage, Converter={StaticResource StatusToBackgroundConverter}}"
                        BorderThickness="1"
                        BorderBrush="{Binding StatusMessage, Converter={StaticResource StatusToBorderConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" 
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Border>

                <!-- Info Footer -->
                <Border Margin="0,32,0,0" Padding="16" 
                        Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                        CornerRadius="8">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="TabuKA v1.0.0" FontSize="12" 
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Text="Ayarlarınız otomatik olarak kaydedilir" FontSize="11" 
                                   Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</UserControl>