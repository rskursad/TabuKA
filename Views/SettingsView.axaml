<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabuKA.ViewModels"
             xmlns:controls="using:TabuKA.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="TabuKA.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.SectionCard">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='14|24|24'}" />
            <Setter Property="BoxShadow" Value="0 6 20 0 #20000000" />
        </Style>

        <Style Selector="Button.NavButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCardBorderBrush}" />
        </Style>

        <Style Selector="Button.DangerButton">
            <Setter Property="Background" Value="{DynamicResource AppDangerButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppDangerButtonFgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="TextBlock.SettingLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.CardTitle">
            <Setter Property="FontSize" Value="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='16|18|18'}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <controls:BrandTriAccent Variant="Corner" AccentOpacity="0.14"
                                 VerticalAlignment="Top" HorizontalAlignment="Right"
                                 Width="200" Height="160" Margin="0,-30,-20,0"
                                 IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='12,16|24,24|24,24'}"
                    HorizontalAlignment="Center" MaxWidth="820">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Button Grid.Column="0" Content="← Ana Menü" Command="{Binding GoBackCommand}"
                                Classes="NavButton tappable" Width="120"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}" />
                        <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                                Classes="NavButton tappable" Padding="12,10"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}"
                                Content="←" FontSize="16" />

                        <Image Grid.Column="1" Source="/Assets/logo-mark.png" Width="28" Height="28"
                               Stretch="Uniform" VerticalAlignment="Center" Margin="10,0,0,0" />

                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Sistem Ayarları"
                                       FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='19|24|24'}"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Görünüm modu, ses, konuşma tanıma ve veri yönetimi"
                                       FontSize="12.5" FontWeight="Medium"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}" />
                        </StackPanel>
                    </Grid>

                    <!-- Loading Indicator -->
                    <Border IsVisible="{Binding IsLoading}"
                            Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                            BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="20" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="24" Height="24" />
                            <TextBlock Text="Yükleniyor..." VerticalAlignment="Center" FontSize="15"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Theme Settings -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="SectionCard">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🎨 Görünüm" Classes="CardTitle" />

                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|2|2'}"
                                                   ColumnSpacing="16" RowSpacing="8">
                                <TextBlock Text="Tema:" Classes="SettingLabel"
                                           controls:ReflowPanel.ChildFixedWidth="120" />
                                <ComboBox ItemsSource="{Binding Themes}" Classes="tappable"
                                          SelectedItem="{Binding SelectedTheme}"
                                          HorizontalAlignment="Stretch" MaxWidth="260"
                                          Padding="12,8" FontSize="14" />
                            </controls:ReflowPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sound Settings -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="SectionCard">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🔊 Ses ve Efekt Ayarları" Classes="CardTitle" />

                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|3|3'}"
                                                   ColumnSpacing="14" RowSpacing="8">
                                <TextBlock Text="Genel Ses:" Classes="SettingLabel"
                                           controls:ReflowPanel.ChildFixedWidth="120" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinWidth="120">
                                    <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding MasterVolume}"
                                            TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding MasterVolume, StringFormat='{}{0}%'}"
                                               FontSize="15" FontWeight="Bold" MinWidth="46"
                                               TextAlignment="Right" Foreground="#10B981"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Button Content="🔔 Sesi Test Et" Command="{Binding TestSoundCommand}"
                                        Classes="NavButton tappable"
                                        controls:ReflowPanel.ChildFixedWidth="150"
                                        Margin="0" />
                            </controls:ReflowPanel>
                        </StackPanel>
                    </Border>

                    <!-- Offline Speech Recognition (Vosk Model) Settings -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="SectionCard">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🎤 Çevrimdışı Ses Tanıma Modeli (Vosk)" Classes="CardTitle" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Vosk Türkçe Modeli" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Sesli tabu algılama için çevrimdışı çalışan Türkçe yapay zekâ ses modeli gereklidir."
                                               FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        CornerRadius="8" Padding="12,6"
                                        Background="{Binding IsModelInstalled, Converter={StaticResource ModelStatusBgConverter}}"
                                        BorderBrush="{Binding IsModelInstalled, Converter={StaticResource ModelStatusBorderConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding ModelStatusText}"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{Binding IsModelInstalled, Converter={StaticResource ModelStatusFgConverter}}" />
                                </Border>
                            </Grid>

                            <!-- Download & Installation Progress -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingModel}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding ModelDownloadStatusMessage}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding ModelDownloadProgress, StringFormat='{}{0:0}%'}"
                                               FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ModelDownloadProgress}"
                                             Height="8" CornerRadius="4" Foreground="#10B981"
                                             Background="{DynamicResource AppCardBackgroundSubtleBrush}" />
                            </StackPanel>

                            <!-- Actions -->
                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|3|3'}"
                                                   ColumnSpacing="10" RowSpacing="8">
                                <Button Content="📥 Modeli İndir ve Kur (~50 MB)"
                                        Command="{Binding DownloadModelCommand}"
                                        Classes="NavButton tappable" Margin="0"
                                        IsVisible="{Binding IsModelInstalled, Converter={StaticResource InverseBoolConverter}}"
                                        IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}" />

                                <Button Content="🔄 Modeli Yeniden Kur"
                                        Command="{Binding DownloadModelCommand}"
                                        Classes="NavButton tappable" Margin="0"
                                        IsVisible="{Binding IsModelInstalled}"
                                        IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}" />

                                <Button Content="🗑️ Modeli Sil"
                                        Command="{Binding DeleteModelCommand}"
                                        Classes="DangerButton tappable" Margin="0"
                                        IsVisible="{Binding IsModelInstalled}"
                                        IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}" />
                            </controls:ReflowPanel>

                            <TextBlock Text="Oyun sırasında anlatıcının söylediği yasaklı kelimeler bu model ile cihazınızda yerel ve gizlilik odaklı olarak algılanır. İnternet gerektirmez."
                                       FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- General Settings -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="SectionCard">
                        <StackPanel Spacing="10">
                            <TextBlock Text="⚙️ Genel Ayarlar" Classes="CardTitle" />

                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|2|2'}"
                                                   ColumnSpacing="16" RowSpacing="6">
                                <TextBlock Text="Otomatik Kaydet:" Classes="SettingLabel"
                                           controls:ReflowPanel.ChildFixedWidth="160" />
                                <ToggleSwitch IsChecked="{Binding AutoSave}" />
                            </controls:ReflowPanel>

                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|2|2'}"
                                                   ColumnSpacing="16" RowSpacing="6">
                                <TextBlock Text="Öğretici Göster:" Classes="SettingLabel"
                                           controls:ReflowPanel.ChildFixedWidth="160" />
                                <ToggleSwitch IsChecked="{Binding ShowTutorial}" />
                            </controls:ReflowPanel>
                        </StackPanel>
                    </Border>

                    <!-- Database Management -->
                    <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Classes="SectionCard">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🗄️ Veritabanı Yönetimi" Classes="CardTitle" />

                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='2|4|4'}"
                                                   ColumnSpacing="10" RowSpacing="8">
                                <TextBlock Text="Kelime Sayısı:" Classes="SettingLabel"
                                           controls:ReflowPanel.ChildFixedWidth="120" />
                                <TextBlock Text="{Binding WordCount}" FontSize="16" FontWeight="Bold"
                                           Foreground="#10B981" VerticalAlignment="Center" />
                                <TextBlock Text="Kategori Sayısı:" Classes="SettingLabel"
                                           controls:ReflowPanel.ChildFixedWidth="140" />
                                <TextBlock Text="{Binding CategoryCount}" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource AppHeroBadgeBorderBrush}" VerticalAlignment="Center" />
                            </controls:ReflowPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Veritabanı" Classes="SettingLabel" />
                                <TextBlock Text="{Binding DatabasePath}" FontSize="12.5"
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|2|2'}"
                                                   ColumnSpacing="8" RowSpacing="8">
                                <Button Classes="NavButton tappable" Command="{Binding ExportDatabaseCommand}"
                                        Content="📤 JSON Olarak Dışa Aktar" Margin="0"
                                        HorizontalContentAlignment="Center" />
                                <Button Classes="NavButton tappable" Command="{Binding BackupDatabaseCommand}"
                                        Content="💾 Veritabanı Yedeği Al" Margin="0"
                                        HorizontalContentAlignment="Center" />
                                <Button Classes="NavButton tappable" Command="{Binding ImportDatabaseCommand}"
                                        Content="📥 JSON'dan İçe Aktar" Margin="0"
                                        HorizontalContentAlignment="Center" />
                                <Button Classes="NavButton tappable" Command="{Binding OpenWordManagementCommand}"
                                        Content="📝 Kelime Yönetimi" Margin="0"
                                        HorizontalContentAlignment="Center" />
                                <Button Classes="DangerButton tappable" Command="{Binding ResetDatabaseCommand}"
                                        Content="🔄 Fabrika Ayarlarına Sıfırla" Margin="0"
                                        HorizontalContentAlignment="Center" />
                            </controls:ReflowPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status Message -->
                    <Border IsVisible="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="16" CornerRadius="10"
                            Background="{Binding StatusMessage, Converter={StaticResource StatusToBackgroundConverter}}"
                            BorderThickness="1"
                            BorderBrush="{Binding StatusMessage, Converter={StaticResource StatusToBorderConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="14"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>

                    <!-- Info Footer -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,8,0,4">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/logo-mark.png" Width="18" Height="18"
                                   Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="TabuKA • v1.1.0" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Ayarlarınız otomatik olarak kaydedilir." FontSize="11"
                                   Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
