<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabuKA.ViewModels"
             xmlns:controls="using:TabuKA.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="TabuKA.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.SectionCard">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BoxShadow" Value="0 6 20 0 #20000000" />
        </Style>

        <Style Selector="Button.NavButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        
        <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCardBorderBrush}" />
        </Style>

        <Style Selector="Button.DangerButton">
            <Setter Property="Background" Value="{DynamicResource AppDangerButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppDangerButtonFgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        
        <Style Selector="TextBlock.SettingLabel">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <controls:BrandTriAccent Variant="Corner" AccentOpacity="0.14"
                                 VerticalAlignment="Top" HorizontalAlignment="Right"
                                 Width="200" Height="160" Margin="0,-30,-20,0" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="24,24" HorizontalAlignment="Center" MaxWidth="820">
                <StackPanel Spacing="20">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="← Ana Menü" Command="{Binding GoBackCommand}" 
                                Classes="NavButton" Width="120"
                                VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4" Orientation="Horizontal">
                            <Image Source="/Assets/logo-mark.png" Width="28" Height="28"
                                   Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Sistem Ayarları" 
                                           FontSize="24" FontWeight="Black" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="300" />
                                <TextBlock Text="Görünüm modu, ses, konuşma tanıma ve veri yönetimi" 
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="300" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                <!-- Loading Indicator -->
                <Border IsVisible="{Binding IsLoading}" 
                        Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                        CornerRadius="12" Padding="24" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="24" Height="24" />
                        <TextBlock Text="Yükleniyor..." VerticalAlignment="Center" FontSize="15" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Theme Settings -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Classes="SectionCard">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🎨 Görünüm" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="Tema:" Classes="SettingLabel" Width="120" />
                            <ComboBox ItemsSource="{Binding Themes}" 
                                      SelectedItem="{Binding SelectedTheme}"
                                      Width="200" Padding="12,8" FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sound Settings -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Classes="SectionCard">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🔊 Ses ve Efekt Ayarları" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                        
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Genel Ses:" Classes="SettingLabel" Width="120" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume}" 
                                        Width="260" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0}%'}" 
                                           FontSize="15" FontWeight="Bold" Width="50" 
                                           Foreground="#10B981"
                                           VerticalAlignment="Center" />
                                <Button Content="🔔 Sesi Test Et" Command="{Binding TestSoundCommand}"
                                        Classes="NavButton" Width="130" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Offline Speech Recognition (Vosk Model) Settings -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Classes="SectionCard">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🎤 Çevrimdışı Ses Tanıma Modeli (Vosk)" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                        
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Vosk Türkçe Modeli" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Sesli tabu algılama için çevrimdışı çalışan Türkçe yapay zekâ ses modeli gereklidir."
                                               FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        CornerRadius="8" Padding="12,6"
                                        Background="{Binding IsModelInstalled, Converter={StaticResource ModelStatusBgConverter}}"
                                        BorderBrush="{Binding IsModelInstalled, Converter={StaticResource ModelStatusBorderConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding ModelStatusText}"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{Binding IsModelInstalled, Converter={StaticResource ModelStatusFgConverter}}" />
                                </Border>
                            </Grid>

                            <!-- Download & Installation Progress -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingModel}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding ModelDownloadStatusMessage}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ModelDownloadProgress, StringFormat='{}{0:0}%'}"
                                               FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ModelDownloadProgress}"
                                             Height="8" CornerRadius="4" Foreground="#10B981"
                                             Background="{DynamicResource AppCardBackgroundSubtleBrush}" />
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="📥 Modeli İndir ve Kur (~50 MB)"
                                        Command="{Binding DownloadModelCommand}"
                                        Classes="NavButton" Width="230"
                                        IsVisible="{Binding IsModelInstalled, Converter={StaticResource InverseBoolConverter}}"
                                        IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}" />

                                <Button Content="🔄 Modeli Yeniden Kur"
                                        Command="{Binding DownloadModelCommand}"
                                        Classes="NavButton" Width="180"
                                        IsVisible="{Binding IsModelInstalled}"
                                        IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}" />

                                <Button Content="🗑️ Modeli Sil"
                                        Command="{Binding DeleteModelCommand}"
                                        Classes="DangerButton" Width="130"
                                        IsVisible="{Binding IsModelInstalled}"
                                        IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}" />
                            </StackPanel>

                            <TextBlock Text="Oyun sırasında anlatıcının söylediği yasaklı kelimeler bu model ile cihazınızda yerel ve gizlilik odaklı olarak algılanır. İnternet gerektirmez."
                                       FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- General Settings -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Classes="SectionCard">
                    <StackPanel Spacing="16">
                        <TextBlock Text="⚙️ Genel Ayarlar" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                        
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Otomatik Kaydet:" Classes="SettingLabel" Width="180" />
                                <ToggleSwitch IsChecked="{Binding AutoSave}" />
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Öğretici Göster:" Classes="SettingLabel" Width="180" />
                                <ToggleSwitch IsChecked="{Binding ShowTutorial}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Database Management -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Classes="SectionCard">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🗄️ Veritabanı Yönetimi" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="Kelime Sayısı:" Classes="SettingLabel" Width="130" />
                            <TextBlock Text="{Binding WordCount}" FontSize="16" FontWeight="Bold" 
                                       Foreground="#10B981" />
                            <TextBlock Text="Kategori Sayısı:" Classes="SettingLabel" Width="130" Margin="24,0,0,0" />
                            <TextBlock Text="{Binding CategoryCount}" FontSize="16" FontWeight="Bold" 
                                       Foreground="{DynamicResource AppHeroBadgeBorderBrush}" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Veritabanı:" Classes="SettingLabel" Width="100" />
                            <TextBlock Text="{Binding DatabasePath}" FontSize="13" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,6,0,0">
                            <Button Grid.Row="0" Grid.Column="0" Classes="NavButton" Command="{Binding ExportDatabaseCommand}"
                                    Content="📤 JSON Olarak Dışa Aktar" Margin="0,0,6,8" />
                            <Button Grid.Row="0" Grid.Column="1" Classes="NavButton" Command="{Binding BackupDatabaseCommand}"
                                    Content="💾 Veritabanı Yedeği Al" Margin="6,0,0,8" />
                            
                            <Button Grid.Row="1" Grid.Column="0" Classes="NavButton" Command="{Binding ImportDatabaseCommand}"
                                    Content="📥 JSON'dan İçe Aktar" Margin="0,0,6,8" />
                            <Button Grid.Row="1" Grid.Column="1" Classes="NavButton" Command="{Binding OpenWordManagementCommand}"
                                    Content="📝 Kelime Yönetimi" Margin="6,0,0,8" />
                            
                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="DangerButton" Command="{Binding ResetDatabaseCommand}"
                                    Content="🔄 Fabrika Ayarlarına Sıfırla" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status Message -->
                <Border IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Padding="16" CornerRadius="10"
                        Background="{Binding StatusMessage, Converter={StaticResource StatusToBackgroundConverter}}"
                        BorderThickness="1"
                        BorderBrush="{Binding StatusMessage, Converter={StaticResource StatusToBorderConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" 
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Border>

                <!-- Info Footer -->
                <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,12,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/logo-mark.png" Width="18" Height="18"
                               Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="TabuKA • v1.1.0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Ayarlarınız otomatik olarak kaydedilir." FontSize="11" 
                               Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</UserControl>