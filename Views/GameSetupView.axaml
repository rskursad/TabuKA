<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabuKA.ViewModels"
             xmlns:controls="using:TabuKA.Views.Controls"
             xmlns:controlsLegacy="using:Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="850"
             x:Class="TabuKA.Views.GameSetupView"
             x:DataType="vm:GameSetupViewModel">

    <Design.DataContext>
        <vm:GameSetupViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.SectionCard">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="{Binding $parent[UserControl].((vm:GameSetupViewModel)DataContext).Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='14|24|24'}" />
            <Setter Property="BoxShadow" Value="0 6 20 0 #20000000" />
        </Style>

        <Style Selector="Border.CategoryChip">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.CategoryChip CheckBox">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="TextBlock.CardTitle">
            <Setter Property="FontSize" Value="{Binding $parent[UserControl].((vm:GameSetupViewModel)DataContext).Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='15|16|16'}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.FieldValue">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.ModernSecondaryBtn">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.ModernSecondaryBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCardBorderBrush}" />
        </Style>

        <Style Selector="Button.ModernPrimaryBtn">
            <Setter Property="Background" Value="{StaticResource BrandHeroGradient}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24,16" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.ModernPrimaryBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandHeroHoverGradient}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <controls:BrandTriAccent Variant="Corner" AccentOpacity="0.14"
                                 VerticalAlignment="Top" HorizontalAlignment="Right"
                                 Width="200" Height="160" Margin="0,-30,-20,0"
                                 IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='12,16|20,24|20,24'}"
                    HorizontalAlignment="Center" MaxWidth="820">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Button Grid.Column="0" Content="← Ana Menü" Command="{Binding GoBackCommand}"
                                Classes="ModernSecondaryBtn tappable"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}" />
                        <Button Grid.Column="0" Content="←" Command="{Binding GoBackCommand}"
                                Classes="ModernSecondaryBtn tappable" Padding="12,8" FontSize="16"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}" />

                        <Image Grid.Column="1" Source="/Assets/logo-mark.png" Width="28" Height="28"
                               Stretch="Uniform" VerticalAlignment="Center" Margin="10,0,0,0" />

                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Oyun Kurulumu"
                                       FontSize="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='19|24|24'}"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Takımları belirleyin, süreyi ve kuralları ayarlayın"
                                       FontSize="12.5" FontWeight="Medium"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='!compact'}" />
                        </StackPanel>
                    </Grid>

                    <!-- 1. Game Rules Card -->
                    <Border Classes="SectionCard">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Oyun Kuralları ve Süre" Classes="CardTitle" />

                            <!-- Time & Pass / Target Score & Voice: dar ekranda alt alta -->
                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|2|2'}"
                                                   ColumnSpacing="16" RowSpacing="16">
                                <!-- Round Time -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Tur Süresi" Classes="FieldLabel" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Slider Grid.Column="0" Minimum="30" Maximum="180" Value="{Binding RoundTimeSeconds}"
                                                TickFrequency="15" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding RoundTimeSeconds, StringFormat='{}{0} sn'}"
                                                   Classes="FieldValue" MinWidth="52" Foreground="#10B981" />
                                    </Grid>
                                </StackPanel>

                                <!-- Pass Limit -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Pas Hakkı (Her Tur)" Classes="FieldLabel" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Slider Grid.Column="0" Minimum="0" Maximum="10" Value="{Binding PassLimit}"
                                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PassLimit, StringFormat='{}{0}'}"
                                                   Classes="FieldValue" MinWidth="42" Foreground="#F59E0B" />
                                    </Grid>
                                    <TextBlock Text="0 = Sınırsız pas"
                                               FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                                </StackPanel>

                                <!-- Target Score -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Kazanma Hedefi" Classes="FieldLabel" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Slider Grid.Column="0" Minimum="0" Maximum="50" Value="{Binding ScoreToWin}"
                                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ScoreToWin, StringFormat='{}{0} Puan'}"
                                                   Classes="FieldValue" MinWidth="62" Foreground="#3B82F6" />
                                    </Grid>
                                    <TextBlock Text="0 = Serbest mod"
                                               FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                                </StackPanel>

                                <!-- Auto Taboo Voice Control -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Sesli Tabu Algılama" Classes="FieldLabel" />
                                    <ToggleSwitch IsChecked="{Binding EnableAutoTabooCheck}"
                                                  OnContent="Açık" OffContent="Kapalı"
                                                  HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding PermissionStatusBadge}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#10B981" TextWrapping="Wrap"
                                               IsVisible="{Binding PermissionStatusBadge, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="Anlatıcının söylediği yasaklı kelimeleri ses algılama motoru ile otomatik tespit eder."
                                               FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:ReflowPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Teams Setup Card -->
                    <Border Classes="SectionCard">
                        <StackPanel Spacing="14">
                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|2|2'}"
                                                   ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Takımlar" Classes="CardTitle" />
                                    <TextBlock Text="Takım sayısını ve adlarını belirleyin"
                                               FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding Responsive.IsCompact, Converter={StaticResource RspVis}, ConverterParameter='compact'}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                            controls:ReflowPanel.ChildFixedWidth="210">
                                    <TextBlock Text="Takım Sayısı:" FontSize="13"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding TeamCount}" Minimum="2" Maximum="6"
                                                   Classes="tappable" Width="100" FontSize="13" />
                                </StackPanel>
                            </controls:ReflowPanel>

                            <ItemsControl ItemsSource="{Binding Teams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AppCardBackgroundSubtleBrush}"
                                                CornerRadius="12" Padding="{Binding $parent[ItemsControl].((vm:GameSetupViewModel)DataContext).Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='14,10,6,10|14,10|14,10'}"
                                                Margin="0,4"
                                                BorderThickness="1.5" BorderBrush="{DynamicResource AppCardBorderBrush}">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Grid.Column="0" Background="{StaticResource BrandHeroGradient}"
                                                        CornerRadius="8" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TeamNumber, StringFormat='Takım {0}'}"
                                                               FontSize="12" FontWeight="Black" Foreground="White" />
                                                </Border>
                                                <TextBox Grid.Column="1" Text="{Binding Name}"
                                                         Classes="tappable"
                                                         PlaceholderText="Takım adını girin..." FontSize="14" FontWeight="SemiBold"
                                                         CornerRadius="8" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 3. Categories Selection Card -->
                    <Border Classes="SectionCard">
                        <StackPanel Spacing="14">
                            <controls:ReflowPanel Columns="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='1|2|2'}"
                                                   ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Kategoriler" Classes="CardTitle" />
                                    <TextBlock Text="Seçim yapılmazsa tüm kategoriler karıştırılır"
                                               FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center"
                                            controls:ReflowPanel.ChildFixedWidth="230">
                                    <Button Content="Tümünü Seç" Command="{Binding SelectAllCategoriesCommand}"
                                            Classes="ModernSecondaryBtn tappable"
                                            Padding="12,6" FontSize="12" Margin="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    <Button Content="Temizle" Command="{Binding DeselectAllCategoriesCommand}"
                                            Classes="ModernSecondaryBtn tappable"
                                            Padding="12,6" FontSize="12" Margin="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </controls:ReflowPanel>

                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controlsLegacy:WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="CategoryChip"
                                                Background="{Binding IsSelected, Converter={StaticResource BoolToCategoryBackgroundConverter}}"
                                                BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToCategoryBorderConverter}}">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding Name}"
                                                      Background="Transparent"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      FontSize="13" Margin="2,0" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SelectedCategories.Count, StringFormat='{}{0} kategori seçildi'}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AppHeroBadgeBorderBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Validation Error Message -->
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#EF4444" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding ValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Launch Game Button -->
                    <Button Content="MAÇI BAŞLAT 🚀"
                            Command="{Binding StartGameCommand}"
                            Classes="ModernPrimaryBtn tappable"
                            FontSize="17" Height="56"
                            HorizontalAlignment="Stretch" MaxWidth="380"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Microphone Permission Confirmation Dialog -->
        <Border IsVisible="{Binding IsPermissionDialogOpen}"
                Background="{DynamicResource AppModalOverlayBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource AppCardBackgroundBrush}"
                    CornerRadius="16"
                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='18,16|28,24|28,24'}"
                    MaxWidth="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='340|400|440'}"
                    Margin="14"
                    BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 16 36 0 #30000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="🎙️" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Mikrofon İzni Gerekli"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="TabuKA'nın oyun sırasında anlatıcının söylediği yasaklı kelimeleri otomatik algılayabilmesi için mikrofon erişimi gerekmektedir.&#x0a;&#x0a;Yalnızca aktif oyun rauntları sırasında kullanılır. İzin vermek istiyor musunuz?"
                               FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="İzin Ver"
                                Command="{Binding GrantMicrophonePermissionCommand}"
                                Classes="ModernPrimaryBtn tappable"
                                Padding="12,12" FontSize="13" Margin="0"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="1" Content="Vazgeç"
                                Command="{Binding DenyMicrophonePermissionCommand}"
                                Classes="ModernSecondaryBtn tappable"
                                Padding="12,12" FontSize="13" Margin="0"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Offline Vosk Model Download & Internal Setup Dialog -->
        <Border IsVisible="{Binding IsModelInstallDialogOpen}"
                Background="{DynamicResource AppModalOverlayBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource AppCardBackgroundBrush}"
                    CornerRadius="16"
                    Padding="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='18,16|28,24|28,24'}"
                    MaxWidth="{Binding Responsive.SizeClass, Converter={StaticResource Rsp}, ConverterParameter='340|400|460'}"
                    Margin="14"
                    BorderThickness="1" BorderBrush="{DynamicResource AppCardBorderBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 16 36 0 #30000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="📥" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Ses Tanıma Modeli Gerekli"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Sesli Tabu Algılama özelliğini açabilmek için çevrimdışı Türkçe ses tanıma modelinin (~50 MB) uygulama içine indirilip kurulması gerekmektedir.&#x0a;&#x0a;Model bir kez kurulduktan sonra internet bağlantısı olmadan tamamen yerel ve gizli çalışır."
                               FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" />

                    <!-- Live Download & Installation Progress -->
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch" IsVisible="{Binding IsDownloadingModel}" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="{Binding ModelInstallStatusMessage}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding ModelInstallProgress, StringFormat='{}{0:0}%'}"
                                       FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ModelInstallProgress}"
                                     Height="8" CornerRadius="4" Foreground="#10B981"
                                     Background="{DynamicResource AppCardBackgroundSubtleBrush}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="İndir ve Kur"
                                Command="{Binding DownloadAndInstallModelCommand}"
                                IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}"
                                Classes="ModernPrimaryBtn tappable"
                                Padding="12,12" FontSize="13" Margin="0"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="1" Content="Vazgeç"
                                Command="{Binding CancelModelInstallDialogCommand}"
                                IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}"
                                Classes="ModernSecondaryBtn tappable"
                                Padding="12,12" FontSize="13" Margin="0"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
