# ============================================================
# TabuKA - Android İmza (Keystore) Yapılandırması
# ============================================================
# Bu dosyayı 'keystore.properties' adıyla kopyalayın ve kendi
# imza anahtarı bilgilerinizi girin:
#   cp keystore.properties.example keystore.properties
#
# DİKKAT: 'keystore.properties' ve '*.keystore' dosyaları
# .gitignore içine eklenmiştir, gizli tutulur ve Git'e gönderilmez.
# ============================================================

# Keystore dosyasının yolu (proje kök dizinine göre veya mutlak yol)
storeFile=tabuka.keystore

# Anahtar takma adı (Key Alias)
keyAlias=tabuka

# Keystore şifresi (OPSİYONEL)
# Boş bırakılırsa 'make android-publish' çalıştırıldığında kullanıcıdan
# etkileşimli olarak istenir (şifreler repo'ya/değişkenlere hazır girilmez).
# storePassword=şifreniz

# Anahtar şifresi (OPSİYONEL; genellikle storePassword ile aynıdır)
# Boş bırakılırsa keystore şifresi kullanılır.
# keyPassword=şifreniz
